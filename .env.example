# Backend API, including /api/v1. Defaults to the live backend if unset.
NEXT_PUBLIC_API_BASE_URL=https://api.pdfquickly.com/api/v1

# Optional ownership tags for Google Search Console and Bing Webmaster Tools.
# Only needed if you verify with the "HTML tag" method rather than DNS.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# IndexNow key; must match the file name in public/. Only needed to override the default.
INDEXNOW_KEY=
